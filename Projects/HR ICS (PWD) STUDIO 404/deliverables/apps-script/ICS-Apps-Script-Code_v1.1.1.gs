/*   Public application form:  <web app link>                           */
/*   Staff Hiring Sheet:       <web app link>?page=staff  (PIN)         */
/*   Interview Evaluation:     <web app link>?page=eval   (PIN to save) */
/* ------------------------------------------------------------------ */

var APP_COLS = ['Received', 'Name', 'WhatsApp', 'City / area', 'Distance', 'Score', 'Result', 'Why', 'Status',
  'Send WhatsApp', 'WA number (auto)', 'Current status', 'Education', 'Experience', 'IT firm before',
  'IT job details', 'Other job now', 'Can stay', 'Shift', 'Own timing', 'Can join', 'CV files'];
var EVAL_COLS = ['Saved at', 'Candidate name', 'WhatsApp', 'Position', 'Interview date', 'Interviewed by', 'Arrival',
  'Communication', 'Skills / practical test', 'Attitude', 'Punctuality', 'Commitment', 'Total (out of 25)',
  'Suggested', 'Final decision', 'Salary offered', 'Joining date', 'Notes'];

/** Run once after setupHiring: adds the extra columns, the Interviews tab, the CV folder and the staff PIN. */
function setupWebApp() {
  var props = PropertiesService.getScriptProperties();
  var ss = SpreadsheetApp.openById(props.getProperty('SHEET_ID'));
  var app = ss.getSheetByName('Applications');
  app.getRange(1, 1, 1, APP_COLS.length).setValues([APP_COLS])
    .setFontWeight('bold').setBackground('#111111').setFontColor('#ffffff');
  var f = app.getFilter();
  if (f) f.remove();
  app.getRange(1, 1, app.getMaxRows(), APP_COLS.length).createFilter();
  app.setColumnWidths(12, 10, 150);
  app.getRange(2, 22, app.getMaxRows() - 1, 1).setWrap(false);

  var iv = ss.getSheetByName('Interviews') || ss.insertSheet('Interviews');
  iv.getRange(1, 1, 1, EVAL_COLS.length).setValues([EVAL_COLS])
    .setFontWeight('bold').setBackground('#111111').setFontColor('#ffffff');
  iv.setFrozenRows(1);

  if (!props.getProperty('CV_FOLDER_ID')) {
    props.setProperty('CV_FOLDER_ID', DriveApp.createFolder('ICS Hiring - CVs').getId());
  }
  if (!props.getProperty('STAFF_PIN')) {
    props.setProperty('STAFF_PIN', String(Math.floor(100000 + Math.random() * 900000)));
  }
  Logger.log('CV folder: ' + DriveApp.getFolderById(props.getProperty('CV_FOLDER_ID')).getUrl());
  Logger.log('Staff PIN: ' + props.getProperty('STAFF_PIN'));
}

function doGet(e) {
  var page = (e && e.parameter && e.parameter.page) || 'apply';
  if (!PAGES[page]) page = 'apply';
  var url = ScriptApp.getService().getUrl();
  var html = PAGES[page]
    .replace(/\{\{(ICS|PSEB|TDP|DP|QR)\}\}/g, function (m, k) { return IMG[k]; })
    .split('{{APP_URL}}').join(url);
  var titles = { apply: 'ICS [PWD] Studio 404: Job Application', staff: 'ICS Hiring Sheet', eval: 'ICS Interview Evaluation' };
  return HtmlService.createHtmlOutput(html)
    .setTitle(titles[page])
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/** Stops spreadsheet formulas being typed into answers, and limits length. */
function clean_(v, max) {
  var s = String(v == null ? '' : v).trim().substring(0, max || 500);
  if (/^[=+\-@]/.test(s)) s = "'" + s;
  return s;
}

function submitApplication(d) {
  d = d || {};
  var name = clean_(d.name, 120);
  var waRaw = clean_(d.wa, 40);
  if (!name || String(waRaw).replace(/[^0-9]/g, '').length < 10) throw new Error('Please fill your name and full WhatsApp number.');
  var files = (d.files || []).slice(0, 5);
  if (!files.length) throw new Error('Please upload your CV.');

  var props = PropertiesService.getScriptProperties();
  var wa = normalizeWhatsApp_(waRaw);
  var stamp = Utilities.formatDate(new Date(), 'Asia/Karachi', 'yyyy-MM-dd HH:mm');
  var blobs = files.map(function (f) {
    var bytes = Utilities.base64Decode(String(f.b64 || ''));
    if (bytes.length > 10 * 1024 * 1024) throw new Error('A file is bigger than 10 MB.');
    return Utilities.newBlob(bytes, String(f.type || 'application/octet-stream'), String(f.name || 'file').substring(0, 150));
  });
  var base = name.replace(/^'/, '') + ' - ' + wa + ' - ' + stamp;
  var root = DriveApp.getFolderById(props.getProperty('CV_FOLDER_ID'));
  var link;
  if (blobs.length === 1) {
    link = root.createFile(blobs[0].setName(base + ' - ' + blobs[0].getName())).getUrl();
  } else {
    var folder = root.createFolder(base);
    blobs.forEach(function (b) { folder.createFile(b); });
    link = folder.getUrl();
  }

  var res = scoreApplication({
    dist: d.dist, edu: d.edu, it: d.it, commit: d.commit,
    shift: d.shift, join: d.join, other: d.other
  });

  var sh = SpreadsheetApp.openById(props.getProperty('SHEET_ID')).getSheetByName('Applications');
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var row = sh.getLastRow() + 1;
    if (row > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 100);
    sh.getRange(row, 1, 1, APP_COLS.length).setValues([[
      new Date(), name, "'" + waRaw.replace(/^'/, ''), clean_(d.area, 200), clean_(d.dist, 60),
      res.score, res.result, res.why, 'New', whatsAppFormula_(row), wa,
      clean_(d.status, 60), clean_(d.edu, 60), clean_(d.exp, 60), clean_(d.it, 10), clean_(d.itd, 500),
      clean_(d.other, 10), clean_(d.commit, 60), clean_(d.shift, 80), clean_(d.shd, 120), clean_(d.join, 60),
      link
    ]]);
    SpreadsheetApp.flush();
  } finally {
    lock.releaseLock();
  }
  return { ok: true };
}

/** Removes applications from the list. They move to a "Deleted" tab, so nothing is lost by mistake. */
function deleteApplications(pin, items) {
  checkPin_(pin);
  items = (items || []).filter(function (x) { return x && Number(x.row) >= 2; });
  if (!items.length) return { deleted: 0 };
  var ss = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID'));
  var sh = ss.getSheetByName('Applications');
  var bin = ss.getSheetByName('Deleted');
  if (!bin) {
    bin = ss.insertSheet('Deleted');
    bin.getRange(1, 1, 1, APP_COLS.length + 1).setValues([['Deleted at'].concat(APP_COLS)]).setFontWeight('bold');
    bin.setFrozenRows(1);
  }
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  var n = 0;
  try {
    items.sort(function (a, b) { return Number(b.row) - Number(a.row); });
    items.forEach(function (x) {
      var row = Number(x.row);
      if (row > sh.getLastRow()) return;
      var vals = sh.getRange(row, 1, 1, APP_COLS.length).getValues()[0];
      // the link code dies with the row, so the candidate's old link stops working
      if (String(vals[1]) !== String(x.name)) return;
      vals[9] = '';
      bin.appendRow([new Date()].concat(vals));
      sh.deleteRow(row);
      n++;
    });
    SpreadsheetApp.flush();
  } finally {
    lock.releaseLock();
  }
  return { deleted: n };
}

/** Saves the admin's remark (Status column) and note for one application. */
function saveRemark(pin, d) {
  checkPin_(pin);
  d = d || {};
  var sh = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID')).getSheetByName('Applications');
  var row = Number(d.row);
  if (!(row >= 2) || row > sh.getLastRow()) throw new Error('Entry not found. Please refresh.');
  if (String(sh.getRange(row, 2).getValue()) !== String(d.name)) throw new Error('List changed. Please refresh and try again.');
  if (!sh.getRange(1, 23).getValue()) sh.getRange(1, 23, 1, 2).setValues([['Remark note', 'Remark updated']]).setFontWeight('bold');
  sh.getRange(row, 9).setValue(clean_(d.remark, 40));
  sh.getRange(row, 23, 1, 2).setValues([[clean_(d.note, 500), new Date()]]);
  return { ok: true };
}

/* ------------------------------------------------------------------ */
/* INTERVIEW REMINDER + RSVP                                           */
/*   Staff press "Reminder" on the staff page, WhatsApp opens with a   */
/*   message and a private link: <site>/confirm?t=<token>.             */
/*   The candidate taps Yes / No there; the answer lands in cols AB-AD. */
/* ------------------------------------------------------------------ */
// Applications columns after the 22 APP_COLS: W note, X note updated, then:
var RC = { IV_DATE: 25, IV_TIME: 26, TOKEN: 27, RSVP: 28, RSVP_WHY: 29, RSVP_AT: 30, REM_AT: 31 };
var RSVP_HEADS = ['Remark note', 'Remark updated', 'Interview date', 'Interview time', 'RSVP link code',
  'RSVP', 'RSVP reason', 'RSVP answered', 'Reminder sent'];

/** Makes sure columns W to AE exist and have headers (runs once, remembered in Script Properties). */
function ensureRsvpCols_(sh) {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('RSVP_COLS') === '2') return;
  if (sh.getMaxColumns() < RC.REM_AT) sh.insertColumnsAfter(sh.getMaxColumns(), RC.REM_AT - sh.getMaxColumns());
  sh.getRange(1, 23, 1, RSVP_HEADS.length).setValues([RSVP_HEADS]).setFontWeight('bold')
    .setBackground('#111111').setFontColor('#ffffff');
  sh.getRange(2, RC.IV_DATE, sh.getMaxRows() - 1, 2).setNumberFormat('@');
  sh.getRange(2, RC.TOKEN, sh.getMaxRows() - 1, 1).setNumberFormat('@');
  props.setProperty('RSVP_COLS', '2');
}

/** Gives every application its own unguessable link code (32 hex characters). Under the lock, so rows cannot shift. */
function fillTokens_(sh) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var last = sh.getLastRow();
    if (last < 2) return;
    var names = sh.getRange(2, 2, last - 1, 1).getValues();
    var rng = sh.getRange(2, RC.TOKEN, last - 1, 1);
    var tok = rng.getValues();
    var changed = false;
    for (var i = 0; i < tok.length; i++) {
      if (names[i][0] && !tok[i][0]) { tok[i][0] = newToken_(); changed = true; }
    }
    if (changed) { rng.setValues(tok); SpreadsheetApp.flush(); }
  } finally {
    lock.releaseLock();
  }
}

function newToken_() {
  return (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '').substring(0, 32).toLowerCase();
}

function fmtWhen_(v) {
  return v instanceof Date ? Utilities.formatDate(v, 'Asia/Karachi', 'd MMM, h:mm a') : String(v || '');
}

/** Staff: saves the interview date/time for one candidate and marks "Reminder sent". A new date or time clears the old answer. */
function saveReminder(pin, d) {
  checkPin_(pin);
  d = d || {};
  var sh = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID')).getSheetByName('Applications');
  ensureRsvpCols_(sh);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var row = Number(d.row);
    if (!(row >= 2) || row > sh.getLastRow()) throw new Error('Entry not found. Please refresh.');
    if (String(sh.getRange(row, 2).getValue()) !== String(d.name)) throw new Error('List changed. Please refresh and try again.');
    var cur = sh.getRange(row, RC.IV_DATE, 1, 7).getValues()[0];
    var date = clean_(d.date, 120), time = clean_(d.time, 40);
    var now = new Date();
    var tok = cur[2] || newToken_();
    var keep = String(cur[0]) === date && String(cur[1]) === time;
    sh.getRange(row, RC.IV_DATE, 1, 2).setNumberFormat('@');
    sh.getRange(row, RC.IV_DATE, 1, 7).setValues([[date, time, tok,
      keep ? cur[3] : '', keep ? cur[4] : '', keep ? cur[5] : '', now]]);
    SpreadsheetApp.flush();
    return { tok: tok, remAt: fmtWhen_(now), cleared: !keep && !!cur[3] };
  } finally {
    lock.releaseLock();
  }
}

/** Finds the row that owns a link code. Returns 0 if not found. */
function rowByToken_(sh, token) {
  token = String(token || '').trim().toLowerCase();
  if (!/^[a-f0-9]{32}$/.test(token) || sh.getLastRow() < 2) return 0;
  ensureRsvpCols_(sh);
  var hit = sh.getRange(2, RC.TOKEN, sh.getLastRow() - 1, 1).createTextFinder(token).matchEntireCell(true).findNext();
  return hit ? hit.getRow() : 0;
}

/** Public (candidate page): only this candidate's first name, interview details and own answer. */
function getRsvp(token) {
  var ss = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID'));
  var sh = ss.getSheetByName('Applications');
  var row = rowByToken_(sh, token);
  if (!row) throw new Error('LINK_NOT_FOUND');
  var name = String(sh.getRange(row, 2).getValue()).replace(/^'/, '').trim();
  var v = sh.getRange(row, RC.IV_DATE, 1, 7).getValues()[0];
  var tsh = ss.getSheetByName('Templates');
  var t = tsh.getRange('B3:B4').getValues();
  var dt = cleanDateTime_(ss, tsh);
  var who = String(t[1][0]);
  return {
    name: name.split(/\s+/)[0],
    date: String(v[0] || dt.date), time: String(v[1] || dt.time),
    addr: String(t[0][0]), who: /^\s*\[/.test(who) ? '' : who,
    rsvp: String(v[3] || ''), why: String(v[4] || ''), at: fmtWhen_(v[5])
  };
}

/** Public (candidate page): saves "Coming" or "Not coming" with an optional reason. */
function saveRsvp(d) {
  d = d || {};
  var ans = d.ans === 'yes' ? 'Coming' : d.ans === 'no' ? 'Not coming' : '';
  if (!ans) throw new Error('Please choose an answer.');
  var sh = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID')).getSheetByName('Applications');
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var row = rowByToken_(sh, d.t);
    if (!row) throw new Error('LINK_NOT_FOUND');
    if (ans === 'Not coming' && (!String(d.why || '').trim() || !String(d.next || '').trim())) throw new Error('Please write the reason and when you can come next.');
    var now = new Date();
    sh.getRange(row, RC.RSVP, 1, 3).setValues([[ans, ans === 'Coming' ? '' : clean_('Reason: ' + String(d.why || '-').trim() + ' | Can come next: ' + String(d.next || '-').trim(), 400), now]]);
    SpreadsheetApp.flush();
    return { rsvp: ans, at: fmtWhen_(now) };
  } finally {
    lock.releaseLock();
  }
}

function checkPin_(pin) {
  var real = PropertiesService.getScriptProperties().getProperty('STAFF_PIN');
  if (!real || String(pin || '').trim() !== real) throw new Error('Wrong PIN');
}

function getDashboard(pin) {
  checkPin_(pin);
  var ss = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID'));
  var sh = ss.getSheetByName('Applications');
  ensureRsvpCols_(sh);
  fillTokens_(sh);
  var last = sh.getLastRow();
  var vals = last < 2 ? [] : sh.getRange(2, 1, last - 1, APP_COLS.length).getValues();
  var notes = last < 2 ? [] : sh.getRange(2, 23, last - 1, RSVP_HEADS.length).getValues();
  var tz = 'Asia/Karachi';
  var today = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  var rows = [];
  vals.forEach(function (r, i) {
    if (!r[1]) return;
    var when = r[0] instanceof Date ? r[0] : null;
    var isToday = when && Utilities.formatDate(when, tz, 'yyyy-MM-dd') === today;
    rows.push({
      id: i + 1,
      sort: when ? when.getTime() : 0,
      today: !!isToday,
      date: when ? (isToday ? 'Today, ' + Utilities.formatDate(when, tz, 'h:mm a') : Utilities.formatDate(when, tz, 'd MMM')) : '',
      name: String(r[1]), phone: String(r[2]).replace(/^'/, ''), area: String(r[3]), dist: String(r[4]),
      score: r[5] === '' ? '' : Number(r[5]), res: String(r[6]), why: String(r[7]), status: String(r[8]),
      waNum: String(r[10] || normalizeWhatsApp_(r[2])), cv: String(r[21] || ''), note: String(notes[i][0] || ''),
      ivDate: String(notes[i][2] || ''), ivTime: String(notes[i][3] || ''), tok: String(notes[i][4] || ''),
      rsvp: String(notes[i][5] || ''), rsvpWhy: String(notes[i][6] || ''), rsvpAt: fmtWhen_(notes[i][7]), remAt: fmtWhen_(notes[i][8]),
      ans: [['Current status', r[11]], ['Education', r[12]], ['Experience', r[13]], ['Worked at IT firm', r[14]], ['IT job details', r[15]], ['Other job now', r[16]], ['Can stay', r[17]], ['Shift', r[18]], ['Own timing', r[19]], ['Can join', r[20]]].map(function (x) { return [x[0], String(x[1] == null ? '' : x[1])]; })
    });
  });
  rows.sort(function (a, b) { return b.sort - a.sort; });
  var tsh = ss.getSheetByName('Templates');
  var t = tsh.getRange('B1:B9').getValues();
  var dt = cleanDateTime_(ss, tsh);
  if (dt.wasDate) {
    tsh.getRange('B1:B4').setNumberFormat('@');
    tsh.getRange('B1:B2').setValues([[dt.date], [dt.time]]);
  }
  return {
    rows: rows,
    tpl: { date: dt.date, time: dt.time, addr: String(t[2][0]), who: String(t[3][0]),
      Shortlist: String(t[5][0]), Maybe: String(t[6][0]), Reject: String(t[7][0]),
      Reminder: (String(t[8][0]).indexOf('choose *Yes, I will come* or') > -1 ? '' : String(t[8][0])) || TEMPLATES.Reminder },
    sheetUrl: ss.getUrl()
  };
}

/** Interview date and time as plain text, e.g. "Tuesday, 17 November 2026" and "11:00 AM", even if Sheets turned them into dates. */
function cleanDateTime_(ss, tsh) {
  var v = tsh.getRange('B1:B2').getValues();
  var shown = tsh.getRange('B1:B2').getDisplayValues();
  var date = v[0][0] instanceof Date ? Utilities.formatDate(v[0][0], ss.getSpreadsheetTimeZone(), 'EEEE, d MMMM yyyy') : String(v[0][0]);
  var time = String(v[1][0]);
  if (v[1][0] instanceof Date) {
    var m = String(shown[1][0]).match(/(\d{1,2}):(\d{2})(?::\d{2})?\s*([AaPp])?/);
    if (m) {
      var h = Number(m[1]);
      if (m[3]) h = h % 12 + (/p/i.test(m[3]) ? 12 : 0);
      time = (h % 12 || 12) + ':' + m[2] + ' ' + (h < 12 ? 'AM' : 'PM');
    } else {
      time = String(shown[1][0]);
    }
  }
  return { date: date, time: time, wasDate: v[0][0] instanceof Date || v[1][0] instanceof Date };
}

/** One-time: turns the interview date and time cells into plain text so Sheets never converts them again. */
function fixTemplateDates() {
  var ss = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID'));
  var tsh = ss.getSheetByName('Templates');
  var dt = cleanDateTime_(ss, tsh);
  tsh.getRange('B1:B4').setNumberFormat('@');
  tsh.getRange('B1:B2').setValues([[dt.date], [dt.time]]);
  SpreadsheetApp.flush();
  Logger.log('Date: ' + tsh.getRange('B1').getValue() + ' | Time: ' + tsh.getRange('B2').getValue());
}

function saveTemplates(pin, t) {
  checkPin_(pin);
  t = t || {};
  var sh = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID')).getSheetByName('Templates');
  sh.getRange('B1:B4').setNumberFormat('@');
  sh.getRange('B1:B4').setValues([[clean_(t.date, 200)], [clean_(t.time, 100)], [clean_(t.addr, 400)], [clean_(t.who, 200)]]);
  sh.getRange('B6:B8').setValues([[clean_(t.Shortlist, 3000)], [clean_(t.Maybe, 3000)], [clean_(t.Reject, 3000)]]);
  if (t.Reminder != null) sh.getRange('A9:B9').setValues([['Reminder', clean_(t.Reminder, 3000)]]);
  return { ok: true };
}

function saveEvaluation(pin, d) {
  checkPin_(pin);
  d = d || {};
  var sh = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID')).getSheetByName('Interviews');
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    sh.appendRow([new Date(), clean_(d.name, 120), "'" + clean_(d.wa, 40).replace(/^'/, ''), clean_(d.position, 60),
      clean_(d.date, 20), clean_(d.by, 80), clean_(d.arrival, 60),
      Number(d.comm) || '', Number(d.skill) || '', Number(d.att) || '', Number(d.punc) || '', Number(d.comt) || '',
      Number(d.total) || 0, clean_(d.suggest, 80), clean_(d.decision, 20), clean_(d.salary, 40), clean_(d.joining, 20),
      clean_(d.notes, 2000)]);
  } finally {
    lock.releaseLock();
  }
  return { ok: true };
}

/** API for the same pages hosted on Netlify (no Google banner). Pages POST JSON as text/plain. */
function doPost(e) {
  var out;
  try {
    var req = JSON.parse(e.postData.contents);
    var r;
    switch (req.action) {
      case 'ping': r = 'pong'; break;
      case 'submitApplication': r = submitApplication(req.data); break;
      case 'getDashboard': r = getDashboard(req.pin); break;
      case 'saveTemplates': r = saveTemplates(req.pin, req.data); break;
      case 'saveEvaluation': r = saveEvaluation(req.pin, req.data); break;
      case 'deleteApplications': r = deleteApplications(req.pin, req.data); break;
      case 'saveRemark': r = saveRemark(req.pin, req.data); break;
      case 'saveReminder': r = saveReminder(req.pin, req.data); break;
      case 'getRsvp': r = getRsvp(req.data && req.data.t); break;
      case 'saveRsvp': r = saveRsvp(req.data); break;
      default: throw new Error('Unknown action');
    }
    out = { ok: true, result: r };
  } catch (err) {
    out = { ok: false, error: String((err && err.message) || err) };
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

/* Page designs (same as the HTML files) and logos. */
