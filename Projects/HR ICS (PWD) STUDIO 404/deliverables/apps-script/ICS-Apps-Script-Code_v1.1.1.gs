r-radius:18px;padding:22px 22px 24px;color:#fff;background:#000;box-shadow:0 10px 30px rgba(0,0,0,.18)}\n.aaw::before{content:\"\";position:absolute;width:380px;height:150px;right:-140px;top:-70px;border:10px solid var(--red);border-radius:50%;transform:rotate(-14deg);opacity:.9}\n.aaw::after{content:\"\";position:absolute;width:320px;height:120px;right:-110px;top:-48px;border:7px solid var(--blue);border-radius:50%;transform:rotate(-14deg)}\n.aaw>*{position:relative;z-index:1}\n.aaw-top{display:flex;align-items:center;justify-content:space-between;gap:10px}\n.aaw-step{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;background:var(--red);color:#fff;border-radius:6px;padding:4px 10px}\n.aaw-ico{width:46px;height:46px;border-radius:12px;background:#fff;display:grid;place-items:center;font-size:24px}\n.aaw h2{margin:12px 0 6px;font-size:24px;line-height:1.2;font-weight:800}\n.aaw p{margin:0;color:#d8dce2;max-width:46ch}\n.aaw-chips{list-style:none;display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:14px 0 18px}\n.aaw-chips li{font-size:13px;font-weight:600;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:6px 12px}\n.aaw-btn{font:inherit;font-weight:800;font-size:16px;display:inline-flex;align-items:center;justify-content:center;gap:10px;background:#fff;color:#111;border:0;border-radius:12px;padding:14px 24px;min-height:52px;cursor:pointer;box-shadow:0 0 0 0 rgba(255,255,255,.6);animation:aawpulse 2.4s infinite}\n.aaw-btn:hover{background:#f1f3f5}\n.aaw-btn span{font-size:20px;transition:transform .15s}\n.aaw-btn:hover span{transform:translateX(4px)}\n.aaw-btn:focus-visible{outline:3px solid var(--blue);outline-offset:3px}\n@keyframes aawpulse{0%{box-shadow:0 0 0 0 rgba(255,255,255,.55)}70%{box-shadow:0 0 0 12px rgba(255,255,255,0)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}}\n@media (prefers-reduced-motion:reduce){.aaw-btn{animation:none}}\n@media (max-width:560px){.aaw::before{width:260px;height:100px;right:-120px;top:-62px;border-width:7px}.aaw::after{width:220px;height:80px;right:-100px;top:-44px;border-width:5px}.aaw{padding:18px 16px 20px}.aaw h2{font-size:21px}.aaw-btn{width:100%}}\n\n.dcard .addr{font-size:16px;margin-bottom:10px}\n.maplink{display:inline-flex;align-items:center;gap:8px;background:var(--blue);color:#fff;text-decoration:none;font-weight:700;border-radius:10px;padding:12px 18px;min-height:46px}\n.maplink:hover{background:#094a8c}\n.what{list-style:none;padding:0!important;margin:4px 0 0!important;display:grid;gap:8px}\n.what li{position:relative;padding:10px 12px 10px 38px;background:#f6f8fa;border-radius:10px;margin:0!important;font-size:15px}\n.what li::before{content:\"✓\";position:absolute;left:12px;top:9px;width:18px;height:18px;border-radius:50%;background:var(--blue);color:#fff;font-size:12px;font-weight:800;display:grid;place-items:center}\n.prog{grid-template-columns:repeat(3,1fr)!important}\n.prog b{font-size:21px!important}\n.earn{margin-top:12px;background:var(--green-soft);border:1.5px solid #b7e4c9;border-radius:12px;padding:12px 14px}\n.earn b{display:block;color:var(--green);font-size:15px}\n.earn span{font-size:14px;color:#35523f}\n.payflow{display:grid;grid-template-columns:1fr auto 1.35fr;gap:10px;align-items:stretch}\n.payflow>div{border-radius:14px;padding:14px;display:flex;flex-direction:column;justify-content:center}\n.payflow small{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;opacity:.8}\n.payflow b{font-size:24px;line-height:1.15;font-weight:800}\n.payflow span{font-size:14px}\n.payflow .p1{background:var(--blue-soft);border:1.5px solid #bcd6f0;color:#0a3d75}\n.payflow .p2{background:linear-gradient(135deg,#0f6b38,#1fa35a);color:#fff;box-shadow:0 8px 20px rgba(19,122,63,.3)}\n.payflow .p2 b{font-size:32px}\n.payflow span b{font-size:inherit;font-weight:800}\n.payflow .arr{background:none!important;padding:0!important;font-size:24px;color:var(--muted);align-self:center}\n.rules-list li{margin-bottom:10px!important}\n@media (max-width:560px){.payflow{grid-template-columns:1fr}.payflow .arr{transform:rotate(90deg);justify-self:center}.prog b{font-size:18px!important}}\n.err{background:var(--red-soft);color:var(--red);border:1.5px solid #f3b9b9;border-radius:10px;padding:12px 14px;margin-top:16px;font-weight:600}\n.btn[disabled]{opacity:.6;cursor:wait}\n.spin{width:18px;height:18px;border:3px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:sp 1s linear infinite}\n@keyframes sp{to{transform:rotate(360deg)}}\n</style>\n</head>\n<body>\n\n\n\n<header class=\"hero\">\n  <div class=\"hero-in\">\n    <img src=\"{{ICS}}\" alt=\"ICS logo\">\n    <div>\n      <p class=\"org\">ICS [PWD] Studio 404</p>\n      <h1 id=\"h1\">Job Application Form</h1>\n      <p class=\"sub\" id=\"sub\">Takes about 3 minutes</p>\n    </div>\n  </div>\n  <div class=\"stripe\"></div>\n</header>\n\n<div class=\"partners\">\n  <div class=\"partners-in\">\n    <span class=\"lbl\">Registered by Government of Pakistan</span>\n    <div class=\"logos\">\n      <img src=\"{{PSEB}}\" alt=\"Pakistan Software Export Board\">\n      <img class=\"tdp\" src=\"{{TDP}}\" alt=\"Tech Destination Pakistan\">\n      <img src=\"{{DP}}\" alt=\"Digital Pakistan, Ministry of IT &amp; Telecom\">\n    </div>\n    <div class=\"qr\"><img src=\"{{QR}}\" alt=\"PSEB registration QR code\"><span><b>Scan to verify</b>PSEB registration</span></div>\n  </div>\n</div>\n\n<template id=\"details\">\n  <div class=\"dcard\">\n    <h3>About us</h3>\n    <p>ICS [PWD] Studio 404 has been working professionally since 2017, for 8 years. We are a software house and an IT institute.</p>\n    <p>Our CEO, <b>Mohammad Zeeshan</b>, also runs registered companies in the US and Germany. Our Managing Director, <b>Mohammad Abbas</b>, manages the institute.</p>\n    <p>We handle social media content monetization, software and web development, celebrity management, and local and international projects.</p>\n  </div>\n\n  <div class=\"dcard\">\n    <h3>Our office</h3>\n    <p class=\"addr\">📍 Building # 25/A, Main Rehmania Road, Opposite Street # 10, Partab Nagar, Faisalabad</p>\n    <a class=\"maplink\" href=\"https://maps.app.goo.gl/WpozvDe7KrWQxYtH8?g_st=iw\" target=\"_blank\" rel=\"noopener\">🗺️ Open in Google Maps <span aria-hidden=\"true\">↗</span></a>\n  </div>\n\n  <div class=\"dcard\">\n    <h3>Registration</h3>\n    <div class=\"reg\">\n      <img src=\"{{QR}}\" alt=\"PSEB registration QR code\">\n      <div>\n        <p><b>Registered by Government of Pakistan</b></p>\n        <p>PSEB registration no.: <b>Z-25-23414/26</b></p>\n        <p style=\"font-size:13px;color:var(--muted)\">Scan the QR code to verify our PSEB registration.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"dcard\">\n    <h3>What we do</h3>\n    <ul class=\"what\">\n      <li>Facebook, TikTok and YouTube content monetization</li>\n      <li>Organic page creation, growth and monetization</li>\n      <li>Completing monetization requirements and generating revenue</li>\n      <li>Organic, AI-generated and celebrity-related content creation</li>\n      <li>AI-powered image and video generation (generative AI)</li>\n      <li>AI-powered automation: YouTube, TikTok and Facebook automation</li>\n      <li>Copyright work</li>\n    </ul>\n  </div>\n\n  <div class=\"dcard\">\n    <h3>Our progress</h3>\n    <div class=\"prog\">\n      <div><b>8 years</b><span>Of work</span></div>\n      <div><b>680+</b><span>Happy clients</span></div>\n      <div><b>20+</b><span>Team members</span></div>\n    </div>\n    <div class=\"earn\">\n      <b>💵 Each team member earns $500+ per month easily.</b>\n      <span>With 20+ team members, that is $10,000+ in revenue every month.</span>\n    </div>\n  </div>\n\n  <div class=\"dcard\">\n    <h3>Work timing</h3>\n    <p>Each shift is <b>9 hours</b> of work. You will be placed on one of these shifts:</p>\n    <div class=\"shifts\">\n      <div class=\"shift\"><b>Shift 1</b><span>11:00 AM to 8:00 PM</span></div>\n      <div class=\"shift\"><b>Shift 2</b><span>2:00 PM to 11:00 PM</span></div>\n      <div class=\"shift\"><b>Shift 3</b><span>4:00 PM to 1:00 AM</span></div>\n    </div>\n    <p style=\"margin-top:10px\">You can also tell us which timing you are most comfortable with, or that you are fine with any shift. You will pick this in the application.</p>\n  </div>\n\n  <div class=\"dcard\">\n    <h3>Pay</h3>\n    <div class=\"payflow\">\n      <div class=\"p1\"><small>Step 1</small><b>1 month</b><span>Unpaid internship</span></div>\n      <div class=\"arr\" aria-hidden=\"true\">→</div>\n      <div class=\"p2\"><small>Step 2 · after the internship</small><b>Rs. 25,000</b><span>Fixed starting salary (Rs. 25,000)</span></div>\n    </div>\n  </div>\n\n  <div class=\"dcard\">\n    <h3>Company rules and regulations</h3>\n    <ol class=\"rules-list\">\n      <li><b>Be on time.</b> Be at your desk exactly when your shift starts. If you are late, you get up to 3 warnings. After 3 warnings without a valid reason, a time penalty applies: you make up the extra hours.</li>\n      <li><b>Dress code.</b> Cultural dress (like shalwar kameez) or formal or semi-formal clothes are fine. Shorts are not allowed.</li>\n      <li><b>Lunch break.</b> You get a 25-minute lunch break. The office has a kitchen, oven, fridge and freezer.</li>\n      <li><b>Prayer.</b> Prayer time is allowed. The time is shared equally between the company and you, and it counts inside your working hours. Example: a 20-minute prayer is 10 minutes from the company and 10 minutes from you.</li>\n      <li><b>No smoking or vaping.</b> Smoking, vaping and pods are not allowed in the office. You may do it only in your lunch break, in the designated smoking zone.</li>\n      <li><b>Conduct.</b> Be respectful and professional with colleagues, clients and visitors.</li>\n      <li><b>Contract.</b> You must sign the contract within 1 week. All rules in it must be followed.</li>\n      <li><b>Mobile phones.</b> You may bring your phone, but only emergency calls are allowed. A penalty applies if you are caught using it otherwise.</li>\n      <li><b>Confidentiality and equipment.</b> Keep company and client information private. Use company equipment for work only. The first month is an unpaid internship, then the fixed starting salary is Rs. 25,000.</li>\n    </ol>\n  </div>\n</template>\n\n<main class=\"wrap\">\n\n  <section id=\"formWrap\">\n  <div class=\"aaw\" role=\"region\" aria-label=\"All Details About Work\">\n    <div class=\"aaw-top\">\n      <span class=\"aaw-step\">Read this first</span>\n      <span class=\"aaw-ico\" aria-hidden=\"true\">📋</span>\n    </div>\n    <h2>All Details About Work</h2>\n    <p>Everything you should know before you apply, in one place. It takes about 2 minutes to read.</p>\n    <ul class=\"aaw-chips\">\n      <li>🏢 Company</li><li>✅ Registration</li><li>🕒 Shifts</li><li>💰 Pay</li><li>📜 Rules</li>\n    </ul>\n    <button type=\"button\" class=\"aaw-btn\" id=\"aaw\">Open All Details <span aria-hidden=\"true\">→</span></button>\n  </div>\n\n  <div class=\"card intro\">\n    <span class=\"aaw-step\" style=\"background:var(--blue-soft);color:var(--blue)\">Then</span>\n    <h2 style=\"margin-top:8px\">Please answer honestly</h2>\n    <p>There are no wrong answers. Shortlisted candidates will get a WhatsApp message with the interview time and details.</p>\n    <ul><li>Fields marked <span class=\"req\">*</span> are required.</li></ul>\n  </div>\n\n  <form id=\"app\" onsubmit=\"event.preventDefault();send()\">\n\n  <p class=\"section-title\">1 · About you</p>\n\n  <div class=\"card q\">\n    <label class=\"qt\" for=\"name\">Full name<span class=\"req\">*</span></label>\n    <input id=\"name\" type=\"text\" placeholder=\"e.g. Ali Raza\" required style=\"margin-top:8px\">\n  </div>\n\n  <div class=\"card q\">\n    <label class=\"qt\" for=\"wa\">WhatsApp number<span class=\"req\">*</span></label>\n    <span class=\"hint\">We will send the interview message to this number.</span>\n    <input id=\"wa\" type=\"tel\" inputmode=\"tel\" placeholder=\"03XX XXXXXXX\" required>\n  </div>\n\n  <div class=\"card q\">\n    <label class=\"qt\" for=\"area\">Current city and area<span class=\"req\">*</span></label>\n    <span class=\"hint\">The area, road or town where you live now.</span>\n    <input id=\"area\" type=\"text\" placeholder=\"e.g. Jang Road, Faisalabad\" required>\n  </div>\n\n  <p class=\"section-title\">2 · Location</p>\n\n  <div class=\"card q\">\n    <span class=\"qt\">How far is our office from your home?<span class=\"req\">*</span></span>\n    <span class=\"hint\">Our office is in Faisalabad.</span>\n    <div class=\"opts two\" data-score=\"dist\">\n      <label class=\"opt\"><input type=\"radio\" name=\"dist\" required>Less than 5 km<small>Under 15 min</small></label>\n      <label class=\"opt\"><input type=\"radio\" name=\"dist\">5 to 10 km<small>15 to 30 min</small></label>\n      <label class=\"opt\"><input type=\"radio\" name=\"dist\">10 to 20 km<small>30 to 60 min</small></label>\n      <label class=\"opt\"><input type=\"radio\" name=\"dist\">More than 20 km<small>Over 1 hour</small></label>\n    </div>\n  </div>\n\n  <p class=\"section-title\">3 · Education &amp; work</p>\n\n  <div class=\"card q\">\n    <span class=\"qt\">What are you doing right now?<span class=\"req\">*</span></span>\n    <div class=\"opts two\" style=\"margin-top:10px\">\n      <label class=\"opt\"><input type=\"radio\" name=\"status\" required>Student</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"status\">Fresh graduate</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"status\">Looking for a job</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"status\">Working, want to switch</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"status\">Freelancer</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"status\">Other</label>\n    </div>\n  </div>\n\n  <div class=\"card q\">\n    <span class=\"qt\">Highest education<span class=\"req\">*</span></span>\n    <div class=\"opts two\" data-score=\"edu\" style=\"margin-top:10px\">\n      <label class=\"opt\"><input type=\"radio\" name=\"edu\" required>Matric</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"edu\">Intermediate / DAE</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"edu\">Bachelor's (in progress)</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"edu\">Bachelor's (complete)</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"edu\">Master's or higher</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"edu\">Short course / diploma only</label>\n    </div>\n  </div>\n\n  <div class=\"card q\">\n    <span class=\"qt\">How much work experience do you have in this field?<span class=\"req\">*</span></span>\n    <div class=\"opts two\" data-score=\"exp\" style=\"margin-top:10px\">\n      <label class=\"opt\"><input type=\"radio\" name=\"exp\" required>None, I am new</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"exp\">Less than 6 months</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"exp\">6 to 12 months</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"exp\">1 to 2 years</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"exp\">2 to 4 years</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"exp\">More than 4 years</label>\n    </div>\n  </div>\n\n  <div class=\"card q\">\n    <span class=\"qt\">Have you worked in an IT firm before?<span class=\"req\">*</span></span>\n    <span class=\"hint\">Any IT, software or IT-related job counts.</span>\n    <div class=\"opts two\" data-score=\"it\">\n      <label class=\"opt\"><input type=\"radio\" name=\"it\" required>Yes</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"it\">No</label>\n    </div>\n    <div id=\"itBox\" style=\"display:none;margin-top:14px\">\n      <label class=\"qt\" for=\"itd\" style=\"font-size:15px\">Where, what job and for how long?</label>\n      <span class=\"hint\">Company name, job title and number of months.</span>\n      <textarea id=\"itd\" style=\"min-height:80px\" placeholder=\"e.g. XYZ Software, Junior Developer, 8 months\"></textarea>\n    </div>\n  </div>\n\n  <div class=\"card q\">\n    <span class=\"qt\">Are you doing any other job right now?<span class=\"req\">*</span></span>\n    <div class=\"opts two\" style=\"margin-top:10px\">\n      <label class=\"opt\"><input type=\"radio\" name=\"other\" value=\"yes\" required>Yes</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"other\" value=\"no\">No</label>\n    </div>\n  </div>\n\n  <p class=\"section-title\">4 · Commitment &amp; timing</p>\n\n  <div class=\"card q\">\n    <span class=\"qt\">If selected, for how long can you surely stay with us?<span class=\"req\">*</span></span>\n    <div class=\"opts two\" data-score=\"commit\" style=\"margin-top:10px\">\n      <label class=\"opt\"><input type=\"radio\" name=\"commit\" required>4 months</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"commit\">6 months</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"commit\">6 months to 1 year</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"commit\">1 year to 1.5 years</label>\n    </div>\n  </div>\n\n  <div class=\"card q\">\n    <span class=\"qt\">Which shift are you comfortable with?<span class=\"req\">*</span></span>\n    <span class=\"hint\">Each shift is 9 hours.</span>\n    <div class=\"opts\" data-score=\"shift\">\n      <label class=\"opt\"><input type=\"radio\" name=\"shift\" required>Shift 1: 11:00 AM to 8:00 PM</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"shift\">Shift 2: 2:00 PM to 11:00 PM</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"shift\">Shift 3: 4:00 PM to 1:00 AM</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"shift\">I am fine with any shift<small>Shift work is OK for me</small></label>\n      <label class=\"opt\"><input type=\"radio\" name=\"shift\" id=\"shOwn\">Other: I prefer my own timing</label>\n    </div>\n    <div id=\"shBox\" style=\"display:none;margin-top:14px\">\n      <label class=\"qt\" for=\"shd\" style=\"font-size:15px\">Tell us the timing you are comfortable with</label>\n      <input id=\"shd\" type=\"text\" placeholder=\"e.g. 12:00 PM to 9:00 PM\">\n    </div>\n  </div>\n\n  <div class=\"card q\">\n    <span class=\"qt\">When can you join?<span class=\"req\">*</span></span>\n    <div class=\"opts two\" data-score=\"join\" style=\"margin-top:10px\">\n      <label class=\"opt\"><input type=\"radio\" name=\"join\" required>Right away</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"join\">Within 1 week</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"join\">Within 2 weeks</label>\n      <label class=\"opt\"><input type=\"radio\" name=\"join\">After 1 month or more</label>\n    </div>\n  </div>\n\n  <p class=\"section-title\">5 · CV</p>\n\n  <div class=\"card q\">\n    <label class=\"qt\" for=\"cv\">Upload your CV and portfolio<span class=\"req\">*</span></label>\n    <span class=\"hint\">Any file works: JPG, PNG, GIF, DOC, DOCX, PDF, MD, ZIP, etc.</span>\n    <label class=\"drop\" for=\"cv\">\n      <span class=\"ic\">📁</span>\n      <b>Tap to choose files</b>\n      <small>JPG · PNG · GIF · DOC · DOCX · PDF · MD · any file</small>\n      <em id=\"fn\"></em>\n    </label>\n    <input id=\"cv\" type=\"file\" multiple required style=\"position:absolute;opacity:0;width:1px;height:1px\">\n    <span class=\"hint\" style=\"margin:10px 0 0\">Up to 5 files, 10 MB each.</span>\n  </div>\n\n  <div class=\"card q\">\n    <label class=\"opt\" style=\"border:0;padding:0;align-items:flex-start\">\n      <input type=\"checkbox\" id=\"promise\" required style=\"margin-top:3px\">\n      <span><b>If I am shortlisted, I will come for the interview at the given time, or tell you on WhatsApp at least 1 day before if I can't.<span class=\"req\">*</span></b></span>\n    </label>\n  </div>\n\n  <div class=\"wacard\">\n    <div class=\"ic\">💬</div>\n    <div class=\"txt\"><h3>Questions? Chat with us on WhatsApp</h3><p>For more information or any question about the job, message us directly: <b>+92 308 7800718</b></p></div>\n    <a class=\"wabtn\" id=\"waLink\" target=\"_blank\" rel=\"noopener\" href=\"\">Chat on WhatsApp</a>\n  </div>\n\n  <div id=\"err\" class=\"err\" style=\"display:none\"></div>\n  <div class=\"actions\">\n    <button type=\"reset\" class=\"btn btn-ghost\" onclick=\"setTimeout(function(){fileName();toggles()},0)\">Clear form</button>\n    <button type=\"submit\" class=\"btn btn-primary\" id=\"go\">Submit application</button>\n  </div>\n  </form>\n\n  <p class=\"foot\">ICS [PWD] Studio 404 · Your information is only used for hiring.</p>\n\n  </section>\n</main>\n\n<dialog id=\"dlg\">\n  <div class=\"dhead\"><b>All Details About Work</b><button type=\"button\" id=\"dclose\">Close</button></div>\n  <div class=\"dbody\" id=\"dbody\"></div>\n</dialog>\n\n<script>\nconst $=id=>document.getElementById(id);\nconst tpl=$('details');\n$('dbody').appendChild(tpl.content.cloneNode(true));\n$('waLink').href='https://wa.me/923087800718?text='+encodeURIComponent('Hello ICS [PWD] Studio 404, I have a question about the job application.');\n$('aaw').onclick=()=>$('dlg').showModal();\n$('dclose').onclick=()=>$('dlg').close();\n$('dlg').addEventListener('click',e=>{if(e.target.id==='dlg')$('dlg').close()});\n\nfunction val(n){return document.querySelector('input[name=\"'+n+'\"]:checked')}\nfunction txt(n){const e=val(n);if(!e)return '';return [...e.closest('label').childNodes].filter(x=>x.nodeType===3).map(x=>x.textContent).join('').trim()}\nfunction toggles(){$('itBox').style.display=txt('it')==='Yes'?'block':'none';$('shBox').style.display=$('shOwn').checked?'block':'none'}\nfunction fileName(){const f=$('cv').files;$('fn').textContent=f.length?[...f].map(x=>x.name).join(', '):''}\n$('cv').addEventListener('change',fileName);\n$('app').addEventListener('change',toggles);\nfunction showErr(m){const e=$('err');e.textContent=m;e.style.display=m?'block':'none';if(m)e.scrollIntoView({behavior:'smooth',block:'center'})}\nfunction readFile(f){return new Promise((ok,bad)=>{const r=new FileReader();r.onload=()=>ok({name:f.name,type:f.type||'application/octet-stream',b64:String(r.result).split(',')[1]||''});r.onerror=()=>bad(new Error('Could not read '+f.name));r.readAsDataURL(f)})}\nfunction busy(on){const b=$('go');b.disabled=on;b.innerHTML=on?'<span class=\"spin\"></span> Sending, please wait…':'Submit application'}\nasync function send(){\n  showErr('');\n  const files=[...$('cv').files];\n  if(!files.length)return showErr('Please upload your CV.');\n  if(files.length>5)return showErr('Please choose up to 5 files.');\n  const big=files.find(f=>f.size>10*1024*1024);\n  if(big)return showErr(big.name+' is bigger than 10 MB. Please choose a smaller file.');\n  const digits=$('wa').value.replace(/[^0-9]/g,'');\n  if(digits.length<10)return showErr('Please write a full WhatsApp number, for example 0300 1234567.');\n  busy(true);\n  let up;\n  try{up=await Promise.all(files.map(readFile))}catch(e){busy(false);return showErr(e.message)}\n  const d={name:$('name').value.trim(),wa:$('wa').value.trim(),area:$('area').value.trim(),dist:txt('dist'),status:txt('status'),edu:txt('edu'),exp:txt('exp'),it:txt('it'),itd:$('itd').value.trim(),other:txt('other'),commit:txt('commit'),shift:txt('shift'),shd:$('shd').value.trim(),join:txt('join'),files:up};\n  google.script.run.withSuccessHandler(done).withFailureHandler(e=>{busy(false);showErr('Sorry, your form was not sent. Please check your internet and press Submit again. ('+(e&&e.message||e)+')')}).submitApplication(d);\n}\nfunction done(){$('app').outerHTML='<div class=\"card intro\" id=\"thanks\" style=\"border-top-color:var(--green)\"><h2>Thank you!</h2><p>We have received your application. If you are shortlisted, we will message you on WhatsApp with the interview time and details.</p></div>';const c=document.querySelector('#formWrap .intro:last-of-type');(document.getElementById('thanks')||c).scrollIntoView({behavior:'smooth',block:'center'})}\n</script>\n</body>\n</html>\n", "staff": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>ICS Hiring Sheet</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --ink:#14161a; --muted:#5d6470; --line:#e3e6ea; --bg:#f3f4f6; --card:#fff;\n  --red:#c00d0d; --blue:#0b5cad; --blue-soft:#e8f1fb; --red-soft:#fdecec;\n  --green:#137a3f; --green-soft:#e6f4ec; --amber:#a35d00; --amber-soft:#fff3e0;\n  --radius:14px;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 \"Inter\",system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif}\n.wrap{max-width:760px;margin:0 auto;padding:0 16px 48px}\n/* header */\n.hero{background:#000;color:#fff;position:relative;overflow:hidden}\n.hero::before,.hero::after{content:\"\";position:absolute;border-radius:50%;pointer-events:none}\n.hero::before{width:520px;height:220px;right:-140px;top:-110px;border:14px solid var(--red);transform:rotate(-14deg);opacity:.85}\n.hero::after{width:440px;height:180px;right:-90px;top:-80px;border:10px solid var(--blue);transform:rotate(-14deg);opacity:.9}\n.hero-in{max-width:760px;margin:0 auto;padding:28px 16px 30px;position:relative;z-index:1;display:flex;gap:18px;align-items:center}\n.hero img{width:96px;height:auto;border-radius:10px;flex:none}\n.hero .org{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#c9ced6;margin:0 0 4px}\n.hero h1{margin:0;font-size:26px;line-height:1.2;font-weight:800}\n.hero .sub{margin:6px 0 0;color:#d8dce2;font-size:15px}\n.stripe{height:6px;background:linear-gradient(90deg,var(--red) 0 50%,var(--blue) 50% 100%)}\n/* partner strip */\n.partners{background:#fff;border-bottom:1px solid var(--line)}\n.partners-in{max-width:760px;margin:0 auto;padding:12px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}\n.partners .lbl{font-size:13px;color:var(--ink);font-weight:700;letter-spacing:.03em;text-transform:uppercase;margin-right:auto;line-height:1.3;max-width:170px}\n.partners .logos{display:flex;gap:14px;align-items:center}\n.partners img{height:50px;width:auto;display:block}\n.partners .logos{gap:20px}\n.partners img.tdp{height:36px}\n@media (max-width:560px){.partners img.tdp{height:30px}.partners .lbl{max-width:none}}\n.qr{display:flex;align-items:center;gap:10px;padding-left:14px;border-left:1px solid var(--line)}\n.qr img{height:84px;min-width:84px;object-fit:contain;width:auto;border:1px solid var(--line);border-radius:6px;padding:3px;background:#fff}\n.qr span{font-size:13px;line-height:1.3;color:var(--muted);font-weight:600}\n.qr b{display:block;color:var(--ink);font-size:13px}\n/* cards */\n.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-top:16px}\n.intro{border-top:6px solid var(--red)}\n.intro h2{margin:0 0 6px;font-size:19px}\n.intro p{margin:0 0 8px;color:var(--muted)}\n.intro ul{margin:8px 0 0;padding-left:20px;color:var(--muted)}\n.section-title{margin:28px 4px 0;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue)}\n.q label.qt,.q .qt{display:block;font-weight:650;font-size:16px}\n.req{color:var(--red);margin-left:2px}\n.hint{display:block;color:var(--muted);font-size:14px;margin:2px 0 12px;font-style:italic}\ninput[type=text],input[type=tel],input[type=date],input[type=time],input[type=url],input[type=email],select,textarea{\n  width:100%;font:inherit;padding:12px 14px;border:1.5px solid #cfd4da;border-radius:10px;background:#fff;color:var(--ink)}\ntextarea{min-height:110px;resize:vertical}\ninput:focus,select:focus,textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(11,92,173,.15)}\n.opts{display:grid;gap:8px}\n.opts.two{grid-template-columns:1fr 1fr}\n.opt{display:flex;align-items:center;gap:10px;padding:11px 14px;border:1.5px solid #dde1e6;border-radius:10px;cursor:pointer;min-height:48px;transition:background .15s,border-color .15s}\n.opt:hover{border-color:#b9c1ca}\n.opt input{accent-color:var(--blue);width:18px;height:18px;margin:0;flex:none}\n.opt:has(input:checked){border-color:var(--blue);background:var(--blue-soft)}\n.opt small{display:block;color:var(--muted);font-size:13px}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:inherit;font-weight:700;border:0;border-radius:10px;padding:14px 22px;cursor:pointer;min-height:48px}\n.btn-primary{background:var(--red);color:#fff}\n.btn-primary:hover{background:#a20b0b}\n.btn-ghost{background:transparent;color:var(--muted)}\n.actions{display:flex;justify-content:space-between;align-items:center;margin-top:20px;gap:12px;flex-wrap:wrap}\n.foot{text-align:center;color:var(--muted);font-size:13px;margin-top:28px}\n.mock-note{background:#fffbe6;border:1px dashed #d9b400;color:#6b5600;border-radius:10px;padding:10px 14px;font-size:14px;margin-top:16px}\n.pill{display:inline-block;font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px}\n.pill.g{background:var(--green-soft);color:var(--green)}\n.pill.a{background:var(--amber-soft);color:var(--amber)}\n.pill.r{background:var(--red-soft);color:var(--red)}\ntable{width:100%;border-collapse:collapse;font-size:14px}\nth,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}\nth{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:#fafbfc}\n.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -4px}\n@media (max-width:560px){\n  .hero-in{flex-direction:column;align-items:flex-start;gap:12px;padding-top:22px}\n  .hero img{width:80px}\n  .hero::before{width:360px;height:150px;right:-170px;top:-70px;border-width:10px}\n  .hero::after{width:300px;height:120px;right:-140px;top:-50px;border-width:7px}\n  .hero h1{font-size:22px}\n  .opts.two{grid-template-columns:1fr}\n  .partners .lbl{width:100%}\n  .partners img{height:42px}\n  .qr img{height:76px;min-width:76px}\n  .qr{border-left:0;padding-left:0;width:100%}\n  .card{padding:16px}\n}\n\n.wrap{max-width:1100px}\n.hero-in{max-width:1100px;padding:20px 16px 22px}\n.hero img{width:64px}\n.hero h1{font-size:22px}\n.partners-in{max-width:1100px}\n.sum{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:16px}\n.stat{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px}\n.stat small{display:block;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:700}\n.stat b{display:block;min-width:0;font-size:30px;line-height:1.2;font-weight:800}\n.stat.t{border-top:5px solid var(--ink)}.stat.g{border-top:5px solid var(--green)}.stat.a{border-top:5px solid #e08a00}.stat.r{border-top:5px solid var(--red)}.stat.n{border-top:5px solid var(--blue)}\n.stat.g b{color:var(--green)}.stat.a b{color:var(--amber)}.stat.r b{color:var(--red)}.stat.n b{color:var(--blue)}\n.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0 10px;align-items:center}\n.tab{font:inherit;font-weight:700;font-size:14px;border:1.5px solid #cfd4da;background:#fff;border-radius:999px;padding:8px 16px;cursor:pointer;min-height:40px}\n.tab span{opacity:.65;margin-left:4px;font-weight:600}\n.tab.on{background:var(--ink);color:#fff;border-color:var(--ink)}\n.tab[data-f=Shortlist].on{background:var(--green);border-color:var(--green)}\n.tab[data-f=Maybe].on{background:#e08a00;border-color:#e08a00}\n.tab[data-f=Reject].on{background:var(--red);border-color:var(--red)}\n.showing{margin-left:auto;font-size:14px;color:var(--muted)}\n.sheet{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}\n.sheet .tbl-wrap{margin:0;max-height:560px;overflow:auto}\n.sheet table{min-width:980px}\n.sheet th{position:sticky;top:0;z-index:1;white-space:nowrap}\n.sheet td{vertical-align:middle}\n.sheet tr.new td:first-child{box-shadow:inset 4px 0 0 var(--blue)}\n.sc{font-weight:800}\n.wa{display:inline-flex;align-items:center;gap:6px;background:#1fa35a;color:#fff;text-decoration:none;font-weight:700;font-size:13px;padding:8px 12px;border-radius:8px;white-space:nowrap}\n.wa.m{background:#e08a00}.wa.r{background:#6b7280}\n.wa:hover{filter:brightness(.92)}\n.nt{font-size:12px;color:var(--muted)}\n.cols{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\n.tpl h3{margin:0 0 6px;font-size:16px;display:flex;gap:8px;align-items:center}\n.tpl textarea{min-height:250px;font-size:14px;line-height:1.45;font-family:inherit}\n.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}\n.fields label{font-size:13px;font-weight:700;display:block;margin-bottom:4px}\n.fields input{padding:10px 12px}\n.colnote{background:var(--blue-soft);border-radius:10px;padding:12px 14px;font-size:14px;margin-top:14px;color:#0a3d75}\ncode{overflow-wrap:anywhere;word-break:break-word;background:#eef0f3;border-radius:5px;padding:1px 5px;font-size:13px}\nbody{overflow-x:hidden}.tbl-wrap,.sheet{max-width:100%}\n@media (max-width:900px){.sum{grid-template-columns:repeat(2,1fr)}.cols{grid-template-columns:1fr}.fields{grid-template-columns:1fr 1fr}.stat.t{grid-column:1/-1}}\n@media (max-width:560px){.hero-in{flex-direction:row;align-items:center}.stat{padding:12px}.fields{grid-template-columns:1fr}.showing{margin-left:0;width:100%}}\n.err{background:var(--red-soft);color:var(--red);border:1.5px solid #f3b9b9;border-radius:10px;padding:12px 14px;margin-top:16px;font-weight:600}\n.navs{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}\n.navl{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:14px;font-weight:700;color:var(--blue);text-decoration:none;background:var(--blue-soft);border:1.5px solid #bcd6f0;border-radius:10px;padding:8px 12px;cursor:pointer;min-height:40px}\n.nt a{color:var(--blue);font-weight:700;text-decoration:none}\n.empty{padding:28px 16px;text-align:center;color:var(--muted)}\n.savebar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:12px}\n.btn-dark{background:var(--ink);color:#fff}\n#app{display:none}\n.dtshow{margin:6px 0 0;font-size:13px;font-style:normal;color:var(--muted,#555)}input[type=date],input[type=time]{cursor:pointer}</style>\n</head>\n<body>\n<header class=\"hero\"><div class=\"hero-in\">\n  <img src=\"{{ICS}}\" alt=\"ICS logo\">\n  <div><p class=\"org\">ICS [PWD] Studio 404 · HR only</p><h1>Hiring Sheet</h1>\n  <p class=\"sub\">Live list of every application. Fills itself from the application form.</p></div>\n</div><div class=\"stripe\"></div></header>\n<div class=\"partners\"><div class=\"partners-in\">\n  <span class=\"lbl\">Registered by Government of Pakistan</span>\n  <div class=\"logos\"><img src=\"{{PSEB}}\" alt=\"PSEB\"><img class=\"tdp\" src=\"{{TDP}}\" alt=\"Tech Destination Pakistan\"><img src=\"{{DP}}\" alt=\"Digital Pakistan\"></div>\n  <div class=\"qr\"><img src=\"{{QR}}\" alt=\"PSEB registration QR code\"><span><b>Scan to verify</b>PSEB registration</span></div>\n</div></div>\n\n<main class=\"wrap\">\n  <div class=\"card intro\" id=\"pinCard\">\n    <h2>Staff only</h2>\n    <p>Enter the staff PIN to open the hiring list.</p>\n    <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:10px\">\n      <input id=\"pin\" type=\"password\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"6-digit PIN\" style=\"max-width:220px\">\n      <button class=\"btn btn-primary\" id=\"pinGo\" type=\"button\">Open</button>\n    </div>\n    <div id=\"pinErr\" class=\"err\" style=\"display:none\"></div>\n  </div>\n  <div id=\"app\">\n  <div class=\"navs\">\n    <button class=\"navl\" type=\"button\" id=\"refresh\">↻ Refresh</button>\n    <a class=\"navl\" id=\"evLink\" href=\"{{APP_URL}}?page=eval\" target=\"_top\">📝 Interview Evaluation</a>\n    <a class=\"navl\" id=\"sheetLink\" href=\"#\" target=\"_blank\" rel=\"noopener\">📊 Open Google Sheet</a>\n    <a class=\"navl\" href=\"{{APP_URL}}\" target=\"_blank\" rel=\"noopener\">📄 Application form</a>\n  </div>\n\n  <p class=\"section-title\">1 · Summary (top of the Sheet)</p>\n  <div class=\"sum\" id=\"sum\"></div>\n\n  <p class=\"section-title\">2 · All applications</p>\n  <div class=\"tabs\" id=\"tabs\"></div>\n  <div class=\"sheet\"><div class=\"tbl-wrap\"><table>\n    <thead><tr><th>#</th><th>Received</th><th>Name</th><th>City / area</th><th>Distance</th><th>Score</th><th>Result</th><th>Why</th><th>Send WhatsApp</th></tr></thead>\n    <tbody id=\"rows\"></tbody></table></div></div>\n  <p class=\"nt\" style=\"margin-top:8px\">Blue edge = received today. “Why” shows the reason for Maybe and Reject, such as double job. The All tab is the default, so the full list is always one tap away. Result: Shortlist 75–100, Maybe 50–74, Reject below 50.</p>\n\n  <p class=\"section-title\">3 · One-click WhatsApp</p>\n  <div class=\"card\">\n    <h2 style=\"margin:0 0 6px;font-size:19px\">How the WhatsApp column works</h2>\n    <p style=\"margin:0;color:var(--muted)\">Each row has a button. It opens WhatsApp with the candidate's number and the right message already written (Shortlist, Maybe or Reject). You read it, press Send. Nothing goes out without you pressing Send.</p>\n    <div class=\"colnote\">Change the interview details and messages below, then press <b>Save changes</b>. They are saved to the Templates tab of your Google Sheet, so the WhatsApp buttons in the Sheet use them too.</div>\n    <div class=\"fields\">\n      <div><label for=\"f-date\">Interview date</label><input id=\"f-date\" type=\"date\" onclick=\"pick(this)\"><div class=\"hint dtshow\" id=\"f-date-show\"></div></div>\n      <div><label for=\"f-time\">Time</label><input id=\"f-time\" type=\"time\" step=\"300\" onclick=\"pick(this)\"><div class=\"hint dtshow\" id=\"f-time-show\"></div></div>\n      <div><label>Office location</label><input id=\"f-addr\" type=\"text\"></div>\n      <div><label>Contact person</label><input id=\"f-who\" type=\"text\"></div>\n    </div>\n  </div>\n  <div class=\"cols\" style=\"margin-top:14px\" id=\"tpls\"></div>\n  <p class=\"nt\" style=\"margin-top:8px\">Edit any message above. The WhatsApp buttons in the table above use your edited text straight away. <code>{name}</code> <code>{date}</code> <code>{time}</code> <code>{address}</code> <code>{contact}</code> are filled per candidate.</p>\n  <div class=\"savebar\"><button class=\"btn btn-dark\" type=\"button\" id=\"saveT\">Save changes</button><span class=\"nt\" id=\"saveMsg\"></span></div>\n  </div>\n</main>\n\n<script>\nconst $=id=>document.getElementById(id);\nconst APP='{{APP_URL}}';\nlet D=[],TPL={},flt='All',PIN='';\nconst esc=t=>String(t==null?'':t).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nfunction count(f){return f==='All'?D.length:D.filter(d=>d.res===f).length}\nfunction fill(t,d){return t.replaceAll('{name}',d.name.split(' ')[0]).replaceAll('{date}',fmtDate()).replaceAll('{time}',fmtTime()).replaceAll('{address}',$('f-addr').value).replaceAll('{contact}',$('f-who').value)}\nfunction link(d){const ta=document.querySelector(`[data-t=\"${d.res}\"]`);if(!ta||!d.waNum)return '';return 'https://api.whatsapp.com/send?phone='+d.waNum+'&text='+encodeURIComponent(fill(ta.value,d))}\nfunction drawSum(){\n  $('sum').innerHTML=[['t','Total forms received',D.length],['g','Shortlist',count('Shortlist')],['a','Maybe',count('Maybe')],['r','Reject',count('Reject')],['n','New today',D.filter(d=>d.today).length]]\n   .map(s=>`<div class=\"stat ${s[0]}\"><small>${s[1]}</small><b>${s[2]}</b></div>`).join('');\n  $('tabs').innerHTML=['All','Shortlist','Maybe','Reject'].map(f=>`<button class=\"tab ${f===flt?'on':''}\" data-f=\"${f}\">${f}<span>${count(f)}</span></button>`).join('')+`<span class=\"showing\">Showing ${count(flt)} of ${D.length} total</span>`;\n  document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{flt=b.dataset.f;drawSum();drawRows()});\n}\nfunction drawRows(){\n  const pill={Shortlist:'g',Maybe:'a',Reject:'r'},cls={Shortlist:'',Maybe:'m',Reject:'r'},lbl={Shortlist:'Send invite',Maybe:'Send “we’ll review”',Reject:'Send thanks'};\n  const list=D.filter(d=>flt==='All'||d.res===flt);\n  if(!list.length){$('rows').innerHTML=`<tr><td colspan=\"9\" class=\"empty\">${D.length?'No one in this group yet.':'No applications yet. They will appear here as soon as someone submits the form.'}</td></tr>`;return}\n  $('rows').innerHTML=list.map(d=>{\n    const ev=APP+'?page=eval&name='+encodeURIComponent(d.name)+'&wa='+encodeURIComponent(d.phone);\n    const extra=[d.cv?`<a href=\"${esc(d.cv)}\" target=\"_blank\" rel=\"noopener\">📁 CV</a>`:'',`<a href=\"${esc(ev)}\" target=\"_top\">📝 Evaluate</a>`].filter(Boolean).join(' · ');\n    const wl=link(d);\n    return `<tr class=\"${d.today?'new':''}\"><td>${d.id}</td><td>${esc(d.date)}</td><td><b>${esc(d.name)}</b><br><span class=\"nt\">${esc(d.phone)}</span><br><span class=\"nt\">${extra}</span></td><td>${esc(d.area)}</td><td>${esc(d.dist)}</td><td class=\"sc\">${esc(d.score)}</td><td><span class=\"pill ${pill[d.res]||''}\">${esc(d.res)}</span></td><td class=\"nt\">${esc(d.why)||'-'}</td><td>${wl?`<a class=\"wa ${cls[d.res]||''}\" target=\"_blank\" rel=\"noopener\" href=\"${esc(wl)}\">💬 ${lbl[d.res]||'Send'}</a>`:'-'}</td></tr>`}).join('');\n}\nconst H={Shortlist:['g','Shortlist: invite to interview'],Maybe:['a','Maybe: keep warm'],Reject:['r','Reject: polite thanks']};\nconst MON=['January','February','March','April','May','June','July','August','September','October','November','December'],DAYN=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nfunction fmtDate(){const v=$('f-date').value;if(!v)return '';const p=v.split('-').map(Number),dt=new Date(Date.UTC(p[0],p[1]-1,p[2]));return DAYN[dt.getUTCDay()]+', '+p[2]+' '+MON[p[1]-1]+' '+p[0]}\nfunction fmtTime(){const v=$('f-time').value;if(!v)return '';let p=v.split(':').map(Number),h=p[0]%12||12;return h+':'+String(p[1]).padStart(2,'0')+' '+(p[0]<12?'AM':'PM')}\nfunction mi(s){return MON.findIndex(x=>x.slice(0,3).toLowerCase()===String(s).slice(0,3).toLowerCase())}\nfunction isoDate(s){s=String(s||'');let m=s.match(/(\\d{4})-(\\d{2})-(\\d{2})/);if(m)return m[0];const z=(y,mo,d)=>y+'-'+String(mo+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');m=s.match(/(\\d{1,2})(?:st|nd|rd|th)?\\s+([A-Za-z]{3,})\\.?,?\\s+(\\d{4})/);if(m&&mi(m[2])>=0)return z(m[3],mi(m[2]),m[1]);m=s.match(/([A-Za-z]{3,})\\.?\\s+(\\d{1,2}),?\\s+(\\d{4})/);if(m&&mi(m[1])>=0)return z(m[3],mi(m[1]),m[2]);m=s.match(/(\\d{1,2})[\\/.-](\\d{1,2})[\\/.-](\\d{4})/);if(m)return z(m[3],m[2]-1,m[1]);return ''}\nfunction hhmm(s){const m=String(s||'').match(/(\\d{1,2}):(\\d{2})(?::\\d{2})?\\s*([AaPp])?/);if(!m)return '';let h=+m[1];if(m[3]){const pm=/p/i.test(m[3]);h=h%12+(pm?12:0)}return String(h).padStart(2,'0')+':'+m[2]}\nfunction showDT(){$('f-date-show').textContent=fmtDate()?'In message: '+fmtDate():'Pick a date';$('f-time-show').textContent=fmtTime()?'In message: '+fmtTime()+' (Pakistan time)':'Pick a time'}\ndocument.addEventListener('change',e=>{if(e.target.id==='f-date'||e.target.id==='f-time'){showDT();drawRows();$('saveMsg').textContent='Not saved yet'}});\nfunction pick(el){try{el.showPicker()}catch(x){}}\nfunction drawTpl(){\n  $('tpls').innerHTML=Object.keys(H).map(k=>`<div class=\"card tpl\" style=\"margin-top:0\"><h3><span class=\"pill ${H[k][0]}\">${k}</span></h3><div class=\"hint\" style=\"margin:0 0 8px;font-style:normal;font-weight:600\">${H[k][1]}</div><textarea data-t=\"${k}\">${esc(TPL[k])}</textarea></div>`).join('');\n  $('f-date').value=isoDate(TPL.date);$('f-time').value=hhmm(TPL.time);showDT();$('f-addr').value=TPL.addr||'';$('f-who').value=TPL.who||'';\n}\ndocument.addEventListener('input',e=>{if(e.target.matches('[data-t],.fields input')){drawRows();$('saveMsg').textContent='Not saved yet'}});\nfunction fail(e){const m=(e&&e.message)||String(e);if(m.indexOf('PIN')>-1){try{localStorage.removeItem('icsPin')}catch(x){};$('app').style.display='none';$('pinCard').style.display='block';$('pinErr').textContent='Wrong PIN. Please try again.';$('pinErr').style.display='block'}else{alertBox('Could not load: '+m)}}\nfunction alertBox(m){$('pinErr').textContent=m;$('pinErr').style.display='block';$('pinCard').style.display='block'}\nfunction load(){\n  google.script.run.withSuccessHandler(r=>{\n    try{localStorage.setItem('icsPin',PIN)}catch(x){}\n    D=r.rows;TPL=r.tpl;$('sheetLink').href=r.sheetUrl;\n    $('pinCard').style.display='none';$('app').style.display='block';\n    drawTpl();drawSum();drawRows();\n  }).withFailureHandler(fail).getDashboard(PIN);\n}\nfunction open_(){PIN=$('pin').value.trim();if(!PIN)return;$('pinErr').style.display='none';$('pinGo').textContent='Opening…';load();setTimeout(()=>$('pinGo').textContent='Open',1500)}\n$('pinGo').onclick=open_;$('pin').addEventListener('keydown',e=>{if(e.key==='Enter')open_()});\n$('refresh').onclick=()=>{$('refresh').textContent='↻ Loading…';google.script.run.withSuccessHandler(r=>{D=r.rows;drawSum();drawRows();$('refresh').textContent='↻ Refresh'}).withFailureHandler(fail).getDashboard(PIN)};\n$('saveT').onclick=()=>{\n  const t={date:fmtDate(),time:fmtTime(),addr:$('f-addr').value,who:$('f-who').value};\n  document.querySelectorAll('[data-t]').forEach(x=>t[x.dataset.t]=x.value);\n  $('saveMsg').textContent='Saving…';\n  google.script.run.withSuccessHandler(()=>{TPL=t;$('saveMsg').textContent='Saved ✓'}).withFailureHandler(e=>$('saveMsg').textContent='Not saved: '+((e&&e.message)||e)).saveTemplates(PIN,t);\n};\ntry{const p=localStorage.getItem('icsPin');if(p){$('pin').value=p;PIN=p;load()}}catch(x){}\n</script>\n</body></html>\n", "eval": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>ICS Interview Evaluation</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --ink:#14161a; --muted:#5d6470; --line:#e3e6ea; --bg:#f3f4f6; --card:#fff;\n  --red:#c00d0d; --blue:#0b5cad; --blue-soft:#e8f1fb; --red-soft:#fdecec;\n  --green:#137a3f; --green-soft:#e6f4ec; --amber:#a35d00; --amber-soft:#fff3e0;\n  --radius:14px;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 \"Inter\",system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif}\n.wrap{max-width:760px;margin:0 auto;padding:0 16px 48px}\n/* header */\n.hero{background:#000;color:#fff;position:relative;overflow:hidden}\n.hero::before,.hero::after{content:\"\";position:absolute;border-radius:50%;pointer-events:none}\n.hero::before{width:520px;height:220px;right:-140px;top:-110px;border:14px solid var(--red);transform:rotate(-14deg);opacity:.85}\n.hero::after{width:440px;height:180px;right:-90px;top:-80px;border:10px solid var(--blue);transform:rotate(-14deg);opacity:.9}\n.hero-in{max-width:760px;margin:0 auto;padding:28px 16px 30px;position:relative;z-index:1;display:flex;gap:18px;align-items:center}\n.hero img{width:96px;height:auto;border-radius:10px;flex:none}\n.hero .org{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#c9ced6;margin:0 0 4px}\n.hero h1{margin:0;font-size:26px;line-height:1.2;font-weight:800}\n.hero .sub{margin:6px 0 0;color:#d8dce2;font-size:15px}\n.stripe{height:6px;background:linear-gradient(90deg,var(--red) 0 50%,var(--blue) 50% 100%)}\n/* partner strip */\n.partners{background:#fff;border-bottom:1px solid var(--line)}\n.partners-in{max-width:760px;margin:0 auto;padding:12px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}\n.partners .lbl{font-size:13px;color:var(--ink);font-weight:700;letter-spacing:.03em;text-transform:uppercase;margin-right:auto;line-height:1.3;max-width:170px}\n.partners .logos{display:flex;gap:14px;align-items:center}\n.partners img{height:50px;width:auto;display:block}\n.partners .logos{gap:20px}\n.partners img.tdp{height:36px}\n@media (max-width:560px){.partners img.tdp{height:30px}.partners .lbl{max-width:none}}\n.qr{display:flex;align-items:center;gap:10px;padding-left:14px;border-left:1px solid var(--line)}\n.qr img{height:84px;min-width:84px;object-fit:contain;width:auto;border:1px solid var(--line);border-radius:6px;padding:3px;background:#fff}\n.qr span{font-size:13px;line-height:1.3;color:var(--muted);font-weight:600}\n.qr b{display:block;color:var(--ink);font-size:13px}\n/* cards */\n.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-top:16px}\n.intro{border-top:6px solid var(--red)}\n.intro h2{margin:0 0 6px;font-size:19px}\n.intro p{margin:0 0 8px;color:var(--muted)}\n.intro ul{margin:8px 0 0;padding-left:20px;color:var(--muted)}\n.section-title{margin:28px 4px 0;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue)}\n.q label.qt,.q .qt{display:block;font-weight:650;font-size:16px}\n.req{color:var(--red);margin-left:2px}\n.hint{display:block;color:var(--muted);font-size:14px;margin:2px 0 12px;font-style:italic}\ninput[type=text],input[type=tel],input[type=date],input[type=url],input[type=email],select,textarea{\n  width:100%;font:inherit;padding:12px 14px;border:1.5px solid #cfd4da;border-radius:10px;background:#fff;color:var(--ink)}\ntextarea{min-height:110px;resize:vertical}\ninput:focus,select:focus,textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(11,92,173,.15)}\n.opts{display:grid;gap:8px}\n.opts.two{grid-template-columns:1fr 1fr}\n.opt{display:flex;align-items:center;gap:10px;padding:11px 14px;border:1.5px solid #dde1e6;border-radius:10px;cursor:pointer;min-height:48px;transition:background .15s,border-color .15s}\n.opt:hover{border-color:#b9c1ca}\n.opt input{accent-color:var(--blue);width:18px;height:18px;margin:0;flex:none}\n.opt:has(input:checked){border-color:var(--blue);background:var(--blue-soft)}\n.opt small{display:block;color:var(--muted);font-size:13px}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:inherit;font-weight:700;border:0;border-radius:10px;padding:14px 22px;cursor:pointer;min-height:48px}\n.btn-primary{background:var(--red);color:#fff}\n.btn-primary:hover{background:#a20b0b}\n.btn-ghost{background:transparent;color:var(--muted)}\n.actions{display:flex;justify-content:space-between;align-items:center;margin-top:20px;gap:12px;flex-wrap:wrap}\n.foot{text-align:center;color:var(--muted);font-size:13px;margin-top:28px}\n.mock-note{background:#fffbe6;border:1px dashed #d9b400;color:#6b5600;border-radius:10px;padding:10px 14px;font-size:14px;margin-top:16px}\n.pill{display:inline-block;font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px}\n.pill.g{background:var(--green-soft);color:var(--green)}\n.pill.a{background:var(--amber-soft);color:var(--amber)}\n.pill.r{background:var(--red-soft);color:var(--red)}\ntable{width:100%;border-collapse:collapse;font-size:14px}\nth,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}\nth{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:#fafbfc}\n.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -4px}\n@media (max-width:560px){\n  .hero-in{flex-direction:column;align-items:flex-start;gap:12px;padding-top:22px}\n  .hero img{width:80px}\n  .hero::before{width:360px;height:150px;right:-170px;top:-70px;border-width:10px}\n  .hero::after{width:300px;height:120px;right:-140px;top:-50px;border-width:7px}\n  .hero h1{font-size:22px}\n  .opts.two{grid-template-columns:1fr}\n  .partners .lbl{width:100%}\n  .partners img{height:42px}\n  .qr img{height:76px;min-width:76px}\n  .qr{border-left:0;padding-left:0;width:100%}\n  .card{padding:16px}\n}\n\n.intro{border-top-color:var(--blue)}\n.badge{display:inline-block;background:var(--red);color:#fff;font-size:11px;font-weight:800;letter-spacing:.12em;padding:4px 10px;border-radius:6px;margin-bottom:8px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.grid2 .qt{font-size:14px;margin-bottom:6px}\n.rate-row{padding:14px 0;border-bottom:1px solid var(--line)}\n.rate-row:last-child{border-bottom:0;padding-bottom:0}\n.rate-row:first-of-type{padding-top:4px}\n.rate-head{display:flex;justify-content:space-between;gap:10px;align-items:baseline}\n.rate-head b{font-size:16px}\n.rate-head span{font-size:13px;color:var(--muted);font-style:italic}\n.look{font-size:13px;color:var(--muted);margin:2px 0 10px}\n.stars{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.stars label{position:relative}\n.stars input{position:absolute;opacity:0;inset:0;cursor:pointer;margin:0}\n.stars span{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:52px;border:1.5px solid #dde1e6;border-radius:10px;font-weight:800;font-size:17px;line-height:1.1;transition:all .15s}\n.stars span small{font-weight:500;font-size:11px;color:var(--muted)}\n.stars input:checked + span{background:var(--blue);border-color:var(--blue);color:#fff}\n.stars input:checked + span small{color:#dbe8f7}\n.stars input:focus-visible + span{box-shadow:0 0 0 3px rgba(11,92,173,.3)}\n.total{display:flex;align-items:center;gap:18px;flex-wrap:wrap}\n.ring{--p:0;width:96px;height:96px;border-radius:50%;background:conic-gradient(var(--c,var(--blue)) calc(var(--p)*1%),#e9ecef 0);display:grid;place-items:center;flex:none}\n.ring div{width:74px;height:74px;border-radius:50%;background:#fff;display:grid;place-items:center;text-align:center;font-weight:800;font-size:22px;line-height:1}\n.ring small{display:block;font-size:11px;color:var(--muted);font-weight:600}\n.total p{margin:0;color:var(--muted);font-size:14px}\n.decide{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\n.decide label{position:relative}\n.decide input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}\n.decide span{display:block;text-align:center;padding:14px 8px;border:2px solid #dde1e6;border-radius:12px;font-weight:800;font-size:16px}\n.decide span small{display:block;font-weight:500;font-size:12px;color:var(--muted);margin-top:2px}\n.decide .s input:checked+span{background:var(--green-soft);border-color:var(--green);color:var(--green)}\n.decide .h input:checked+span{background:var(--amber-soft);border-color:var(--amber);color:var(--amber)}\n.decide .r input:checked+span{background:var(--red-soft);border-color:var(--red);color:var(--red)}\n.decide input:focus-visible+span{box-shadow:0 0 0 3px rgba(11,92,173,.3)}\n.suggest{margin-top:12px;font-size:14px;color:var(--muted)}\n#selectBox{display:none}\n@media (max-width:560px){.grid2{grid-template-columns:1fr}.decide span{font-size:15px;padding:12px 4px}}\n.err{background:var(--red-soft);color:var(--red);border:1.5px solid #f3b9b9;border-radius:10px;padding:12px 14px;margin-top:16px;font-weight:600}\n.btn[disabled]{opacity:.6;cursor:wait}\n.navl{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:700;color:var(--blue);text-decoration:none;background:var(--blue-soft);border:1.5px solid #bcd6f0;border-radius:10px;padding:8px 12px}\n.pinrow{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-top:10px}\n.pinrow input{max-width:200px}\n</style>\n</head>\n<body>\n\n<header class=\"hero\">\n  <div class=\"hero-in\">\n    <img src=\"{{ICS}}\" alt=\"ICS logo\">\n    <div>\n      <p class=\"org\">ICS [PWD] Studio 404 · Internal</p>\n      <h1>Interview Evaluation</h1>\n      <p class=\"sub\">Fill in right after the interview</p>\n    </div>\n  </div>\n  <div class=\"stripe\"></div>\n</header>\n\n<div class=\"partners\">\n  <div class=\"partners-in\">\n    <span class=\"lbl\">Registered by Government of Pakistan</span>\n    <div class=\"logos\">\n      <img src=\"{{PSEB}}\" alt=\"Pakistan Software Export Board\">\n      <img class=\"tdp\" src=\"{{TDP}}\" alt=\"Tech Destination Pakistan\">\n      <img src=\"{{DP}}\" alt=\"Digital Pakistan, Ministry of IT &amp; Telecom\">\n    </div>\n    <div class=\"qr\"><img src=\"{{QR}}\" alt=\"PSEB registration QR code\"><span><b>Scan to verify</b>PSEB registration</span></div>\n  </div>\n</div>\n\n<main class=\"wrap\">\n\n  <div class=\"card intro\">\n    <span class=\"badge\">STAFF ONLY</span>\n    <h2>One form per candidate</h2>\n    <p>Rate each point from 1 (poor) to 5 (excellent). The score adds up automatically. Answers go to the same Google Sheet as the application, matched by WhatsApp number.</p>\n    <a class=\"navl\" href=\"{{APP_URL}}?page=staff\" target=\"_top\">← Back to Hiring Sheet</a>\n  </div>\n\n  <div class=\"card\" id=\"pinCard\">\n    <label class=\"qt\" for=\"pin\" style=\"font-weight:700\">Staff PIN<span class=\"req\">*</span></label>\n    <span class=\"hint\">Needed to save. It is remembered on this phone or computer.</span>\n    <input id=\"pin\" type=\"password\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"6-digit PIN\" style=\"max-width:220px\">\n  </div>\n\n  <form id=\"ev\" onsubmit=\"event.preventDefault();send()\">\n\n  <p class=\"section-title\">1 · Candidate</p>\n  <div class=\"card\">\n    <div class=\"grid2\">\n      <div><label class=\"qt\" for=\"cn\">Candidate name<span class=\"req\">*</span></label><input id=\"cn\" type=\"text\" required></div>\n      <div><label class=\"qt\" for=\"cw\">WhatsApp number<span class=\"req\">*</span></label><input id=\"cw\" type=\"tel\" placeholder=\"03XX XXXXXXX\" required></div>\n      <div><label class=\"qt\" for=\"cr\">Position<span class=\"req\">*</span></label>\n        <select id=\"cr\" required><option value=\"\">Choose one</option><option>Graphic Designer</option><option>Video Editor</option><option>Social Media Executive</option><option>Web Developer</option><option>Office / Admin Assistant</option><option>Other</option></select></div>\n      <div><label class=\"qt\" for=\"cd\">Interview date<span class=\"req\">*</span></label><input id=\"cd\" type=\"date\" required></div>\n      <div><label class=\"qt\" for=\"ci\">Interviewed by<span class=\"req\">*</span></label><input id=\"ci\" type=\"text\" required></div>\n      <div><label class=\"qt\" for=\"ct\">Arrival<span class=\"req\">*</span></label>\n        <select id=\"ct\" required><option value=\"\">Choose one</option><option>On time or early</option><option>Late, under 15 min</option><option>Late, over 15 min</option><option>Late, did not inform</option></select></div>\n    </div>\n  </div>\n\n  <p class=\"section-title\">2 · Ratings (1 to 5)</p>\n  <div class=\"card\" id=\"ratings\"></div>\n\n  <div class=\"card\">\n    <div class=\"total\">\n      <div class=\"ring\" id=\"ring\"><div><span id=\"tn\">0</span><small>/ 25</small></div></div>\n      <div>\n        <b style=\"font-size:17px\">Total score: <span id=\"tp\">0</span>%</b>\n        <p id=\"tmsg\">Rate all 5 points to see a suggestion.</p>\n        <p style=\"margin-top:6px;font-size:13px\">Guide: 20+ Select · 15–19 Hold · under 15 Reject. Any single 1 = think twice.</p>\n      </div>\n    </div>\n  </div>\n\n  <p class=\"section-title\">3 · Decision</p>\n  <div class=\"card\">\n    <span class=\"qt\">Final decision<span class=\"req\">*</span></span>\n    <span class=\"hint\">The final decision is the interviewer's. The score is only a guide.</span>\n    <div class=\"decide\">\n      <label class=\"s\"><input type=\"radio\" name=\"dec\" value=\"s\" required><span>Select<small>Offer the job</small></span></label>\n      <label class=\"h\"><input type=\"radio\" name=\"dec\" value=\"h\"><span>Hold<small>Decide later</small></span></label>\n      <label class=\"r\"><input type=\"radio\" name=\"dec\" value=\"r\"><span>Reject<small>Not suitable</small></span></label>\n    </div>\n\n    <div id=\"selectBox\" style=\"margin-top:16px\">\n      <div class=\"grid2\">\n        <div><label class=\"qt\" for=\"os\">Salary offered (PKR)</label><input id=\"os\" type=\"text\" inputmode=\"numeric\" placeholder=\"e.g. 35,000\"></div>\n        <div><label class=\"qt\" for=\"oj\">Joining date</label><input id=\"oj\" type=\"date\"></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"card q\">\n    <label class=\"qt\" for=\"nt\">Notes</label>\n    <span class=\"hint\">Strengths, concerns, anything they said about leaving soon, salary talk, etc.</span>\n    <textarea id=\"nt\" placeholder=\"e.g. Good Photoshop test. Lives 6 km away, has bike. Wants 40k. Said may go abroad next year.\"></textarea>\n  </div>\n\n  <div id=\"err\" class=\"err\" style=\"display:none\"></div>\n  <div class=\"actions\">\n    <button type=\"reset\" class=\"btn btn-ghost\" onclick=\"setTimeout(calc,0)\">Clear</button>\n    <button type=\"submit\" class=\"btn btn-primary\" id=\"go\">Save evaluation</button>\n  </div>\n  </form>\n\n  <p class=\"foot\">ICS [PWD] Studio 404 · Internal use only. Do not share with candidates.</p>\n</main>\n\n<script>\nconst crit=[\n  ['comm','Communication','Speaks clearly, understands questions, polite on WhatsApp and in person.'],\n  ['skill','Skills / practical test','Quality of portfolio or small test task done in the office.'],\n  ['att','Attitude','Willing to learn, takes feedback well, respectful.'],\n  ['punc','Punctuality','Came on time, replied on time, informed if late.'],\n  ['comt','Commitment','Clear plan to stay 1 year+, no studies abroad or exams clash soon.']\n];\nconst lab=['Poor','Weak','OK','Good','Great'];\ndocument.getElementById('ratings').innerHTML=crit.map(c=>\n `<div class=\"rate-row\"><div class=\"rate-head\"><b>${c[1]}<span class=\"req\">*</span></b></div>\n  <p class=\"look\">${c[2]}</p><div class=\"stars\">${[1,2,3,4,5].map(n=>\n  `<label><input type=\"radio\" name=\"${c[0]}\" value=\"${n}\" required aria-label=\"${c[1]} ${n}\"><span>${n}<small>${lab[n-1]}</small></span></label>`).join('')}</div></div>`).join('');\nfunction calc(){\n  let t=0,n=0,low=false;\n  crit.forEach(c=>{const e=document.querySelector(`input[name=${c[0]}]:checked`);if(e){t+=+e.value;n++;if(e.value==='1')low=true}});\n  const p=Math.round(t/25*100),ring=document.getElementById('ring');\n  document.getElementById('tn').textContent=t;document.getElementById('tp').textContent=p;\n  ring.style.setProperty('--p',p);\n  let msg='Rate all 5 points to see a suggestion.',c='var(--blue)';\n  if(n===5){\n    if(t>=20&&!low){msg='Suggested: Select';c='var(--green)'}\n    else if(t>=15){msg='Suggested: Hold'+(low?' (one area rated 1)':'');c='var(--amber)'}\n    else{msg='Suggested: Reject';c='var(--red)'}\n  }\n  ring.style.setProperty('--c',c);document.getElementById('tmsg').textContent=msg;\n  document.getElementById('selectBox').style.display=document.querySelector('input[name=dec][value=s]:checked')?'block':'none';\n}\ndocument.getElementById('ev').addEventListener('change',calc);\nconst $=id=>document.getElementById(id);\ntry{const p=localStorage.getItem('icsPin');if(p){$('pin').value=p}}catch(x){}\nif(window.google&&google.script&&google.script.url){google.script.url.getLocation(function(l){const p=l.parameter||{};if(p.name)$('cn').value=p.name;if(p.wa)$('cw').value=p.wa})}\n$('cd').valueAsDate=new Date();\nfunction showErr(m){const e=$('err');e.textContent=m;e.style.display=m?'block':'none';if(m)e.scrollIntoView({behavior:'smooth',block:'center'})}\nfunction busy(on){const b=$('go');b.disabled=on;b.textContent=on?'Saving…':'Save evaluation'}\nfunction v(n){const e=document.querySelector('input[name='+n+']:checked');return e?e.value:''}\nfunction send(){\n  showErr('');\n  const pin=$('pin').value.trim();\n  if(!pin){$('pin').focus();return showErr('Please enter the staff PIN at the top.')}\n  const dec={s:'Select',h:'Hold',r:'Reject'}[v('dec')];\n  const d={name:$('cn').value.trim(),wa:$('cw').value.trim(),position:$('cr').value,date:$('cd').value,by:$('ci').value.trim(),arrival:$('ct').value,\n    comm:v('comm'),skill:v('skill'),att:v('att'),punc:v('punc'),comt:v('comt'),total:$('tn').textContent,suggest:$('tmsg').textContent,decision:dec,salary:$('os').value.trim(),joining:$('oj').value,notes:$('nt').value.trim()};\n  busy(true);\n  google.script.run.withSuccessHandler(function(){try{localStorage.setItem('icsPin',pin)}catch(x){};done()}).withFailureHandler(function(e){busy(false);showErr((e&&e.message||String(e)).indexOf('PIN')>-1?'Wrong staff PIN. Please check it and try again.':'Not saved. Please check your internet and try again. ('+(e&&e.message||e)+')')}).saveEvaluation(pin,d);\n}\nfunction done(){const f=document.getElementById('ev');f.outerHTML='<div class=\"card intro\" style=\"border-top-color:var(--green)\"><h2>Evaluation saved</h2><p>It is now in the Interviews tab of the Hiring Sheet.</p><p><a class=\"navl\" href=\"{{APP_URL}}?page=staff\" target=\"_top\">← Back to Hiring Sheet</a> <a class=\"navl\" href=\"{{APP_URL}}?page=eval\" target=\"_top\">+ New evaluation</a></p></div>';document.getElementById('pinCard').style.display='none';window.scrollTo(0,0)}\n</script>\n</body>\n</html>\n"};

var IMG = {"ICS": "data:image/jpeg;base64,", "PSEB": "data:image/jpeg;base64,", "TDP": "data:image/jpeg;base64,", "DP": "data:image/jpeg;base64,", "QR": "data:image/png;base64,"};
